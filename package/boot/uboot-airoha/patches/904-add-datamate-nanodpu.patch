diff --git a/defenvs/an7583_nanoDPU_env b/defenvs/an7583_nanoDPU_env
new file mode 100644
--- /dev/null
+++ b/defenvs/an7583_nanoDPU_env
@@ -0,0 +1,14 @@
+loadaddr=0x81800000
+ipaddr=192.168.1.1
+serverip=192.168.1.10
+bootargs=console=ttyS0,115200 earlycon root=/dev/fit0 rootwait
+bootcmd=run boot_production
+bootfile_upg=openwrt-airoha-an7583-datamate_nanoDPU-squashfs-sysupgrade.itb
+part_default=production
+boot_production=run emmc_read_production && bootm $loadaddr
+boot_tftp_production=tftpboot $loadaddr $bootfile_upg && iminfo $loadaddr && run emmc_write_production
+mmc_read_vol=mmc read $loadaddr $part_addr 0x100 && imszb $loadaddr image_size && test 0x$image_size -le 0x$part_size && mmc read $loadaddr $part_addr $image_size
+mmc_write_vol=imszb $loadaddr image_size && test 0x$image_size -le 0x$part_size && mmc erase $part_addr $image_size && mmc write $loadaddr $part_addr $image_size
+emmc_read_production=part start mmc 0 $part_default part_addr && part size mmc 0 $part_default part_size && run mmc_read_vol
+emmc_write_production=part start mmc 0 $part_default part_addr && part size mmc 0 $part_default part_size && run mmc_write_vol
+boot_tftp=tftpboot $loadaddr $bootfile_upg && bootm $loadaddr
