/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "an7583.dtsi"

/ {
	model = "Datamate NanoDPU";
	compatible = "datamate,nanoDPU", "airoha,an7583", "airoha,en7583";

	aliases {
		serial0 = &uart1;
	};

	chosen {
		bootargs = "console=ttyS0,115200 earlycon root=/dev/fit0 rootwait";
		rootdisk = <&emmc_rootdisk>;
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x2 0x00000000>;
	};

	leds {
		compatible = "gpio-leds";

		led-api-green {
			color = <LED_COLOR_ID_GREEN>;
			function = "api";
			gpios = <&an7583_pinctrl 2 GPIO_ACTIVE_LOW>;
		};

		led-api-red {
			color = <LED_COLOR_ID_RED>;
			function = "api";
			gpios = <&an7583_pinctrl 1 GPIO_ACTIVE_LOW>;
		};

		led-pon-green {
			color = <LED_COLOR_ID_GREEN>;
			function = "pon";
			gpios = <&an7583_pinctrl 3 GPIO_ACTIVE_LOW>;
		};

		led-pon-red {
			color = <LED_COLOR_ID_RED>;
			function = "pon";
			gpios = <&an7583_pinctrl 12 GPIO_ACTIVE_LOW>;
		};
	};

	sfp: sfp {
		compatible = "sff,sfp";

		i2c-bus = <&i2c0>;

		mod-def0-gpios = <&an7583_pinctrl 18 GPIO_ACTIVE_LOW>;
		los-gpios = <&an7583_pinctrl 13 GPIO_ACTIVE_HIGH>;
		tx-disable-gpios = <&an7583_pinctrl 15 GPIO_ACTIVE_HIGH>;
		tx-fault-gpios = <&an7583_pinctrl 17 GPIO_ACTIVE_HIGH>;
	};
};

&an7583_pinctrl {
	gpio-ranges = <&an7583_pinctrl 0 2 53>;

	i2c0_pins: i2c0-pins {
		mux {
			function = "i2c";
			groups = "i2c0";
		};
	};

	mmc_pins: mmc-pins {
		mux {
			function = "emmc";
			groups = "emmc";
		};
	};
};

&mmc0 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc_pins>;
	pinctrl-1 = <&mmc_pins>;
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	card@0 {
		compatible = "mmc-card";
		reg = <0>;

		block {
			compatible = "block-device";

			partitions {
				emmc_rootdisk: block-partition-production {
					partname = "production";
				};
			};
		};
	};
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins>;
	status = "okay";

	temp-sensor@48 {
		compatible = "adi,adt75";
		reg = <0x48>;
		#thermal-sensor-cells = <0>;
	};
};

&usb_phy {
	status = "okay";
};

&usb0 {
	status = "okay";
};

&npu {
	status = "okay";
};

&eth {
	status = "okay";
};

&gdm2 {
	status = "okay";

	sfp = <&sfp>;

	managed = "in-band-status";
	phy-mode = "sgmii";
};

&gdm3 {
	status = "okay";
	managed = "in-band-status";
	phy-mode = "2500base-x";
};
