From: Robert Marko <robert.marko@sartura.hr>
Subject: [PATCH] nvmem: add a read-only eMMC RPMB provider

Expose opt-in eMMC RPMB storage through NVMEM using the RPMB framework.
Support byte reads across 256-byte data blocks and reject transport,
response status and nonce errors. No writes or key programming are exposed.

This provider does not verify response MACs and must not be used as an
authenticated storage interface. Existing NVMEM layouts can interpret
the data, including U-Boot environments with their own CRC validation.

Signed-off-by: Robert Marko <robert.marko@sartura.hr>
---
--- a/drivers/nvmem/Kconfig
+++ b/drivers/nvmem/Kconfig
@@ -29,6 +29,16 @@ source "drivers/nvmem/layouts/Kconfig"
 
 # Devices
 
+config NVMEM_RPMB
+	tristate "Read-only eMMC RPMB support"
+	depends on RPMB && MMC_BLOCK && OF
+	help
+	  Expose eMMC RPMB data as read-only NVMEM when an mmc-rpmb-nvmem
+	  child node is present below the MMC card. Response MACs are not
+	  verified; this is not an authenticated storage interface.
+
+	  If built as a module, it will be called nvmem-rpmb.
+
 config NVMEM_AN8855_EFUSE
 	tristate "Airoha AN8855 eFuse support"
 	depends on COMPILE_TEST
--- a/drivers/nvmem/Makefile
+++ b/drivers/nvmem/Makefile
@@ -10,6 +10,8 @@ nvmem_layouts-y			:= layouts.o
 obj-y				+= layouts/
 
 # Devices
+obj-$(CONFIG_NVMEM_RPMB)		+= nvmem-rpmb.o
+nvmem-rpmb-y			:= rpmb.o
 obj-$(CONFIG_NVMEM_AN8855_EFUSE)	+= nvmem-an8855-efuse.o
 nvmem-an8855-efuse-y 			:= an8855-efuse.o
 obj-$(CONFIG_NVMEM_APPLE_EFUSES)	+= nvmem-apple-efuses.o
--- /dev/null
+++ b/drivers/nvmem/rpmb.c
@@ -0,0 +1,233 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Read-only eMMC RPMB NVMEM provider.
+ *
+ * Responses are checked for protocol errors and the request nonce, but their
+ * MAC is not verified. This provider does not offer authenticated storage.
+ */
+#include <linux/device.h>
+#include <linux/list.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/nvmem-provider.h>
+#include <linux/of.h>
+#include <linux/random.h>
+#include <linux/rpmb.h>
+#include <linux/slab.h>
+#include <linux/sizes.h>
+
+#define RPMB_DATA_SIZE		256
+#define RPMB_READ_RESPONSE	(RPMB_READ_DATA << 8)
+
+struct rpmb_nvmem {
+	struct device dev;
+	struct rpmb_dev *rdev;
+	struct nvmem_device *nvmem;
+	struct list_head list;
+	struct mutex lock; /* Serializes reads against transport removal. */
+	unsigned int size;
+	bool dead;
+};
+
+static LIST_HEAD(rpmb_nvmem_devices);
+static DEFINE_MUTEX(rpmb_nvmem_devices_lock);
+
+static int rpmb_nvmem_read(void *context, unsigned int offset, void *val,
+			   size_t bytes)
+{
+	struct rpmb_nvmem *priv = context;
+	struct rpmb_frame *req, *resp;
+	u8 *out = val;
+	int ret = 0;
+
+	if (offset > priv->size || bytes > priv->size - offset)
+		return -EINVAL;
+	if (!bytes)
+		return 0;
+
+	/* The MMC transport uses these buffers for DMA. */
+	req = kzalloc(sizeof(*req), GFP_KERNEL);
+	resp = kzalloc(sizeof(*resp), GFP_KERNEL);
+	if (!req || !resp) {
+		ret = -ENOMEM;
+		goto out_free;
+	}
+
+	mutex_lock(&priv->lock);
+	if (priv->dead) {
+		ret = -ENODEV;
+		goto out_unlock;
+	}
+
+	while (bytes) {
+		unsigned int skip = offset % RPMB_DATA_SIZE;
+		size_t count = min_t(size_t, bytes, RPMB_DATA_SIZE - skip);
+
+		memset(req, 0, sizeof(*req));
+		memset(resp, 0, sizeof(*resp));
+		req->req_resp = cpu_to_be16(RPMB_READ_DATA);
+		req->addr = cpu_to_be16(offset / RPMB_DATA_SIZE);
+		req->block_count = cpu_to_be16(1);
+		get_random_bytes(req->nonce, sizeof(req->nonce));
+
+		ret = rpmb_route_frames(priv->rdev, (u8 *)req, sizeof(*req),
+					(u8 *)resp, sizeof(*resp));
+		if (ret)
+			break;
+		if (be16_to_cpu(resp->req_resp) != RPMB_READ_RESPONSE ||
+		    resp->result || resp->addr != req->addr ||
+		    memcmp(resp->nonce, req->nonce, sizeof(req->nonce))) {
+			ret = -EIO;
+			break;
+		}
+
+		memcpy(out, resp->data + skip, count);
+		out += count;
+		offset += count;
+		bytes -= count;
+	}
+
+out_unlock:
+	mutex_unlock(&priv->lock);
+out_free:
+	kfree(resp);
+	kfree(req);
+	return ret;
+}
+
+static void rpmb_nvmem_release(struct device *dev)
+{
+	struct rpmb_nvmem *priv = container_of(dev, struct rpmb_nvmem, dev);
+
+	of_node_put(dev->of_node);
+	rpmb_dev_put(priv->rdev);
+	kfree(priv);
+}
+
+static int rpmb_nvmem_add(struct device *dev)
+{
+	struct rpmb_dev *rdev = to_rpmb_dev(dev);
+	struct nvmem_config config = {};
+	struct device_node *np;
+	struct rpmb_nvmem *priv;
+	struct device *card;
+	int ret;
+
+	if (rdev->descr.type != RPMB_TYPE_EMMC)
+		return 0;
+
+	/* MMC's RPMB character device is between the class device and card. */
+	card = dev->parent ? dev->parent->parent : NULL;
+	if (!card)
+		return 0;
+
+	np = of_get_child_by_name(dev_of_node(card), "rpmb");
+	if (!np)
+		return 0;
+	if (!of_device_is_available(np) ||
+	    !of_device_is_compatible(np, "mmc-rpmb-nvmem")) {
+		of_node_put(np);
+		return 0;
+	}
+
+	/* eMMC RPMB uses a 16-bit address in units of 256 data bytes. */
+	if (!rdev->descr.capacity || rdev->descr.capacity > 128) {
+		of_node_put(np);
+		return -EINVAL;
+	}
+
+	priv = kzalloc(sizeof(*priv), GFP_KERNEL);
+	if (!priv) {
+		of_node_put(np);
+		return -ENOMEM;
+	}
+
+	priv->rdev = rpmb_dev_get(rdev);
+	priv->size = rdev->descr.capacity * SZ_128K;
+	mutex_init(&priv->lock);
+	device_initialize(&priv->dev);
+	priv->dev.parent = dev;
+	priv->dev.of_node = np;
+	priv->dev.release = rpmb_nvmem_release;
+	ret = dev_set_name(&priv->dev, "%s-nvmem", dev_name(dev));
+	if (ret)
+		goto err_put;
+	ret = device_add(&priv->dev);
+	if (ret)
+		goto err_put;
+
+	config.dev = &priv->dev;
+	config.of_node = np;
+	config.name = dev_name(&priv->dev);
+	config.id = NVMEM_DEVID_NONE;
+	config.owner = THIS_MODULE;
+	config.priv = priv;
+	config.size = priv->size;
+	config.word_size = 1;
+	config.stride = 1;
+	config.read_only = true;
+	config.root_only = true;
+	config.ignore_wp = true;
+	config.reg_read = rpmb_nvmem_read;
+	priv->nvmem = nvmem_register(&config);
+	if (IS_ERR(priv->nvmem)) {
+		ret = PTR_ERR(priv->nvmem);
+		device_del(&priv->dev);
+		goto err_put;
+	}
+
+	mutex_lock(&rpmb_nvmem_devices_lock);
+	list_add_tail(&priv->list, &rpmb_nvmem_devices);
+	mutex_unlock(&rpmb_nvmem_devices_lock);
+	return 0;
+
+err_put:
+	dev_err(dev, "Failed to register RPMB NVMEM provider: %d\n", ret);
+	put_device(&priv->dev);
+	return ret;
+}
+
+static void rpmb_nvmem_remove(struct device *dev)
+{
+	struct rpmb_nvmem *priv, *found = NULL;
+
+	mutex_lock(&rpmb_nvmem_devices_lock);
+	list_for_each_entry(priv, &rpmb_nvmem_devices, list) {
+		if (&priv->rdev->dev == dev) {
+			list_del(&priv->list);
+			found = priv;
+			break;
+		}
+	}
+	mutex_unlock(&rpmb_nvmem_devices_lock);
+	if (!found)
+		return;
+
+	/* Drain reads before the transport is removed; reject later reads. */
+	mutex_lock(&found->lock);
+	found->dead = true;
+	mutex_unlock(&found->lock);
+	nvmem_unregister(found->nvmem);
+	/* Outstanding NVMEM references keep the parent and private data alive. */
+	device_unregister(&found->dev);
+}
+
+static struct class_interface rpmb_nvmem_interface = {
+	.add_dev = rpmb_nvmem_add,
+	.remove_dev = rpmb_nvmem_remove,
+};
+
+static int __init rpmb_nvmem_init(void)
+{
+	return rpmb_interface_register(&rpmb_nvmem_interface);
+}
+module_init(rpmb_nvmem_init);
+
+static void __exit rpmb_nvmem_exit(void)
+{
+	rpmb_interface_unregister(&rpmb_nvmem_interface);
+}
+module_exit(rpmb_nvmem_exit);
+
+MODULE_DESCRIPTION("Read-only eMMC RPMB NVMEM provider");
+MODULE_LICENSE("GPL");
